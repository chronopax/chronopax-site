---
import RootLayout from '@/layouts/RootLayout.astro';
import siteConfig from '../../../content/site.json';

const SITE_TITLE = siteConfig.title;
---

<RootLayout title={`Adventures — ${SITE_TITLE}`} description="Field notes and observations." width="lg">
  <div class="page-header">
    <span class="eyebrow">Field notes &amp; observations</span>
    <h1>Adventures</h1>
  </div>

  <section class="category-section">
    <h2 class="category-heading">Adventures in Travel</h2>
    <div class="posts-grid">
      <div class="post-card placeholder-card">
        <div class="post-image-placeholder"></div>
        <div class="post-meta">
          <span class="post-tag">Travel</span>
          <span class="post-date">—</span>
        </div>
        <h3 class="post-title">Coming soon</h3>
      </div>
      <div class="post-card placeholder-card">
        <div class="post-image-placeholder"></div>
        <div class="post-meta">
          <span class="post-tag">Travel</span>
          <span class="post-date">—</span>
        </div>
        <h3 class="post-title">Coming soon</h3>
      </div>
      <div class="post-card placeholder-card">
        <div class="post-image-placeholder"></div>
        <div class="post-meta">
          <span class="post-tag">Travel</span>
          <span class="post-date">—</span>
        </div>
        <h3 class="post-title">Coming soon</h3>
      </div>
    </div>
    <p class="category-note">Travel notes, trip reports, and places worth remembering. Posts coming soon.</p>
  </section>

  <section class="category-section">
    <h2 class="category-heading">Adventures in Tech</h2>
    <div class="posts-grid">
      <div class="post-card placeholder-card">
        <div class="post-image-placeholder"></div>
        <div class="post-meta">
          <span class="post-tag">Tech</span>
          <span class="post-date">—</span>
        </div>
        <h3 class="post-title">Coming soon</h3>
      </div>
      <div class="post-card placeholder-card">
        <div class="post-image-placeholder"></div>
        <div class="post-meta">
          <span class="post-tag">Tech</span>
          <span class="post-date">—</span>
        </div>
        <h3 class="post-title">Coming soon</h3>
      </div>
      <div class="post-card placeholder-card">
        <div class="post-image-placeholder"></div>
        <div class="post-meta">
          <span class="post-tag">Tech</span>
          <span class="post-date">—</span>
        </div>
        <h3 class="post-title">Coming soon</h3>
      </div>
    </div>
    <p class="category-note">Technical writeups, project notes, and things I figured out the hard way. Posts coming soon.</p>
  </section>
</RootLayout>

<style>
  .page-header {
    padding: 3rem 2rem 0;
    max-width: 90rem;
    margin: 0 auto;
  }

  .eyebrow {
    display: block;
    font-size: 11px;
    color: var(--color-accent-teal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: bold;
    color: var(--color-text-primary);
    margin-bottom: 0;
  }

  .category-section {
    max-width: 90rem;
    margin: 2.5rem auto 0;
    padding: 0 2rem;
  }

  .category-heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .post-card {
    background: var(--color-bg-card);
    border: 0.5px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .post-image-placeholder {
    width: 100%;
    aspect-ratio: 16/9;
    background: var(--color-bg-hover);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem 0.25rem;
  }

  .post-tag {
    font-size: 10px;
    color: var(--color-accent-teal);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .post-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    padding: 0 1rem 1rem;
    margin: 0;
  }

  .category-note {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }
</style>
