---
import RootLayout from "../../layouts/RootLayout.astro";
---

<RootLayout title="Shop — Chronopax" description="Gear & Resources" width="md">
  <div class="page-header">
    <span class="eyebrow">Gear & Resources</span>
    <h1>Shop</h1>
  </div>

  <div class="coming-soon-wrap">
    <div class="coming-soon-card">
      <h2>Coming Soon</h2>
      <p>The shop is being set up. Check back soon for computer gear,
        lab equipment, and resources. Payments will be processed securely via Stripe.</p>
      <a href="/contact" class="card-cta">Looking for something specific? Reach out →</a>
    </div>
  </div>
</RootLayout>

<style lang="scss">
  .page-header {
    margin: 3rem 0 2rem;
  }

  .eyebrow {
    display: block;
    font-size: 11px;
    color: var(--color-accent-teal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: bold;
    color: var(--color-text-primary);
  }

  .coming-soon-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 4rem;
  }

  .coming-soon-card {
    background: var(--color-bg-card);
    border: 0.5px solid var(--color-border);
    border-radius: 8px;
    padding: 2rem 2.5rem;
    max-width: 480px;
    text-align: center;

    h2 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--color-text-primary);
      margin-bottom: 0.75rem;
    }

    p {
      font-size: 0.9rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
      margin-bottom: 1.25rem;
    }
  }

  .card-cta {
    font-size: 0.875rem;
    color: var(--color-accent-orange);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
</style>
