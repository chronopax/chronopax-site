---
import RootLayout from "../layouts/RootLayout.astro";
import siteConfig from '../../content/site.json';

const SITE_TITLE = siteConfig.title;
const SITE_DESCRIPTION = siteConfig.description;
---

<RootLayout title={SITE_TITLE} description={SITE_DESCRIPTION} width="md">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-text">
      <h1 class="hero-name">Joe Burley</h1>
      <p class="hero-title">Architect. Builder. The one who makes it work.</p>
      <p class="hero-bio">
        I've spent years building the infrastructure that organizations depend on —
        cloud systems, security stacks, compliance frameworks, and AI integrations.
        Currently based in San Diego. Available for consulting and open to
        conversations about the right opportunities.

        This site is also home to the projects I'm building independently —
        open source tools, early-stage platforms, and experiments worth sharing.
      </p>
      <div class="hero-links">
        <a href="https://www.linkedin.com/in/burleyjoe/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">LinkedIn</a>
        <a href="https://www.credly.com/users/joseph-burley" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Credly</a>
        <a href="https://patreon.com/Chronopax" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Patreon</a>
        <a href="/contact" class="btn btn-primary">Contact</a>
      </div>
    </div>
    <div class="hero-avatar">
      <img src="/avatar.png" alt="Joe Burley" />
    </div>
  </section>

  <!-- Pinned Projects -->
  <section class="projects-section">
    <div class="section-header">
      <span class="eyebrow">What I'm building</span>
      <h2>Projects</h2>
    </div>
    <div class="projects-grid">
      <div class="project-card">
        <span class="card-tag">Open Source</span>
        <h3 class="card-title">Email Cleaner Agent</h3>
        <p class="card-desc">An autonomous email management agent with a contributor economy
          model. AGPL-3.0 licensed with a dual-licensing path for commercial use.
          Built for people who want their inbox handled without giving up control.</p>
        <a href="#" class="card-cta">Learn more →</a>
        <a href="/contact" class="card-interest">Interested in contributing or following development? Get in touch →</a>
      </div>
      <div class="project-card">
        <span class="card-tag">In Development</span>
        <h3 class="card-title">Document Intelligence System</h3>
        <p class="card-desc">A document processing and intelligence platform with
          tenant-isolated architecture. Built for secure, compliance-sensitive
          environments. Early access coming.</p>
        <a href="#" class="card-cta">Learn more →</a>
        <a href="/contact" class="card-interest">Interested in early access or collaboration? Get in touch →</a>
      </div>
      <div class="project-card">
        <span class="card-tag tag-orange">Coming Soon</span>
        <h3 class="card-title">Home Agent Orchestration</h3>
        <p class="card-desc">A framework for orchestrating AI agents across home lab and
          personal infrastructure. Design phase — more details coming soon.</p>
        <a href="#" class="card-cta">Follow progress →</a>
        <a href="/contact" class="card-interest">Want to know when this is ready? Get in touch →</a>
      </div>
    </div>
  </section>
</RootLayout>

<style lang="scss">
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    margin: 3rem 0 4rem;

    @media (max-width: 700px) {
      flex-direction: column-reverse;
      align-items: flex-start;
      margin: 2rem 0 3rem;
    }
  }

  .hero-text {
    flex: 1;
  }

  .hero-name {
    font-size: 2.5rem;
    font-weight: bold;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: 1.1rem;
    color: var(--color-accent-orange);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .hero-bio {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 480px;
    margin-bottom: 1.5rem;
    white-space: pre-line;
  }

  .hero-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;

    &.btn-primary {
      background: var(--color-accent-orange);
      color: #fff;
      border: 1px solid var(--color-accent-orange);

      &:hover {
        background: var(--color-accent-orange-dark);
        border-color: var(--color-accent-orange-dark);
      }
    }

    &.btn-outline {
      background: transparent;
      color: var(--color-text-primary);
      border: 1px solid var(--color-border-hover);

      &:hover {
        border-color: var(--color-accent-orange);
        color: var(--color-accent-orange);
      }
    }
  }

  .hero-avatar {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-accent-orange);
    flex-shrink: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }
  }

  .projects-section {
    margin-bottom: 3rem;
  }

  .section-header {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    display: block;
    font-size: 11px;
    color: var(--color-accent-teal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .section-header h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;

    @media (max-width: 700px) {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    background: var(--color-bg-card);
    border: 0.5px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    transition: border-color 0.2s;

    &:hover {
      border-color: var(--color-accent-orange);
    }

    .card-tag {
      display: block;
      font-size: 11px;
      color: var(--color-accent-teal);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;

      &.tag-orange {
        color: var(--color-accent-orange);
      }
    }

    .card-title {
      font-size: 1rem;
      font-weight: 500;
      color: var(--color-text-primary);
      margin-bottom: 0.4rem;
    }

    .card-desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .card-cta {
      font-size: 0.875rem;
      color: var(--color-accent-orange);
      margin-top: 0.75rem;
      display: block;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }

    .card-interest {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.5rem;
      display: block;
      text-decoration: none;

      &:hover {
        color: var(--color-accent-teal);
        text-decoration: underline;
      }
    }
  }
</style>
