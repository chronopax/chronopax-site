---
import RootLayout from "../layouts/RootLayout.astro";
import siteConfig from '../../content/site.json';
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";

const SITE_TITLE = siteConfig.title;
const SITE_DESCRIPTION = siteConfig.description;
const featured = projects.filter((p) => p.featured);
---

<RootLayout title={SITE_TITLE} description={SITE_DESCRIPTION} width="md">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-text">
      <h1 class="hero-name">Joe Burley</h1>
      <p class="hero-title">Network · Cloud · Systems Architect</p>
      <p class="hero-bio">
        Twenty years designing and delivering connectivity that actually works —
        from SMB fiber installs to Tier 1 carrier backbone architecture,
        hospitality property networks to low-latency infrastructure for finance
        and gaming. BGP routing, SD-WAN, DIA, wireless, voice, video, and the
        cloud migrations that followed.

        I've spent most of that time in the space between what was sold and what
        gets built — the place where requirements change, timelines shift, and
        someone has to make it work anyway. Now applying that foundation to cloud
        architecture, security, and AI systems.

        Based in San Diego. Available for consulting. Building things on the side.
      </p>
      <div class="hero-links">
        <a href="https://www.linkedin.com/in/burleyjoe/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">LinkedIn</a>
        <a href="https://www.credly.com/users/joseph-burley" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Credly</a>
        <a href="https://patreon.com/Chronopax" target="_blank" rel="noopener noreferrer" class="btn btn-outline">Patreon</a>
        <a href="/contact" class="btn btn-primary">Contact</a>
      </div>
    </div>
    <div class="hero-avatar">
      <img src="/avatar.webp" alt="Joe Burley" width="180" height="270" />
    </div>
  </section>

  <!-- Pinned Projects -->
  <section class="projects-section">
    <div class="section-header">
      <span class="eyebrow">What I'm building</span>
      <h2>Projects</h2>
    </div>
    <div class="projects-grid">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
    <a href="/projects" class="all-projects">See all projects →</a>
  </section>
</RootLayout>

<style lang="scss">
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    margin: 3rem 0 4rem;

    @media (max-width: 700px) {
      flex-direction: column-reverse;
      align-items: flex-start;
      margin: 2rem 0 3rem;
    }
  }

  .hero-text {
    flex: 1;
  }

  .hero-name {
    font-size: 2.5rem;
    font-weight: bold;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: 1.1rem;
    color: var(--color-accent-orange);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .hero-bio {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 480px;
    margin-bottom: 1.5rem;
    white-space: pre-line;
  }

  .hero-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;

    &.btn-primary {
      background: var(--color-accent-orange);
      color: #fff;
      border: 1px solid var(--color-accent-orange);

      &:hover {
        background: var(--color-accent-orange-dark);
        border-color: var(--color-accent-orange-dark);
      }
    }

    &.btn-outline {
      background: transparent;
      color: var(--color-text-primary);
      border: 1px solid var(--color-border-hover);

      &:hover {
        border-color: var(--color-accent-orange);
        color: var(--color-accent-orange);
      }
    }
  }

  .hero-avatar {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-accent-orange);
    flex-shrink: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }
  }

  .projects-section {
    margin-bottom: 3rem;
  }

  .section-header {
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    display: block;
    font-size: 11px;
    color: var(--color-accent-teal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .section-header h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;

    @media (max-width: 700px) {
      grid-template-columns: 1fr;
    }
  }

  .all-projects {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-accent-orange);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
</style>
