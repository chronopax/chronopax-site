---
import RootLayout from "../../layouts/RootLayout.astro";
---

<RootLayout title="Projects — Chronopax" description="What Joe Burley is building." width="md">
  <section class="page-header">
    <span class="eyebrow">What I'm building</span>
    <h1>Projects</h1>
  </section>

  <div class="projects-grid">
    <div class="project-card">
      <span class="card-tag">Open Source</span>
      <h2 class="card-title">Email Cleaner Agent</h2>
      <p class="card-desc">An autonomous email management agent with a contributor economy
        model. AGPL-3.0 licensed with a dual-licensing path for commercial use.
        Built for people who want their inbox handled without giving up control.</p>
      <a href="#" class="card-cta">Learn more →</a>
      <a href="/contact" class="card-interest">Interested in contributing or following development? Get in touch →</a>
    </div>
    <div class="project-card">
      <span class="card-tag">In Development</span>
      <h2 class="card-title">Document Intelligence System</h2>
      <p class="card-desc">A document processing and intelligence platform with
        tenant-isolated architecture. Built for secure, compliance-sensitive
        environments. Early access coming.</p>
      <a href="#" class="card-cta">Learn more →</a>
      <a href="/contact" class="card-interest">Interested in early access or collaboration? Get in touch →</a>
    </div>
    <div class="project-card">
      <span class="card-tag tag-orange">Coming Soon</span>
      <h2 class="card-title">Home Agent Orchestration</h2>
      <p class="card-desc">A framework for orchestrating AI agents across home lab and
        personal infrastructure. Design phase — more details coming soon.</p>
      <a href="#" class="card-cta">Follow progress →</a>
      <a href="/contact" class="card-interest">Want to know when this is ready? Get in touch →</a>
    </div>
  </div>

  <div class="patreon-line">
    <a href="https://patreon.com/Chronopax" target="_blank" rel="noopener noreferrer" class="patreon-link">Support this work on Patreon →</a>
  </div>
</RootLayout>

<style lang="scss">
  .page-header {
    margin: 3rem 0 2rem;
  }

  .eyebrow {
    display: block;
    font-size: 11px;
    color: var(--color-accent-teal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: bold;
    color: var(--color-text-primary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;

    @media (max-width: 700px) {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    background: var(--color-bg-card);
    border: 0.5px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    transition: border-color 0.2s;

    &:hover {
      border-color: var(--color-accent-orange);
    }

    .card-tag {
      display: block;
      font-size: 11px;
      color: var(--color-accent-teal);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;

      &.tag-orange {
        color: var(--color-accent-orange);
      }
    }

    .card-title {
      font-size: 1rem;
      font-weight: 500;
      color: var(--color-text-primary);
      margin-bottom: 0.4rem;
    }

    .card-desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .card-cta {
      font-size: 0.875rem;
      color: var(--color-accent-orange);
      margin-top: 0.75rem;
      display: block;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }

    .card-interest {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.5rem;
      display: block;
      text-decoration: none;

      &:hover {
        color: var(--color-accent-teal);
        text-decoration: underline;
      }
    }
  }

  .patreon-line {
    margin-bottom: 3rem;
  }

  .patreon-link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;

    &:hover {
      color: var(--color-accent-orange);
      text-decoration: underline;
    }
  }
</style>
