---
import RootLayout from "../../layouts/RootLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";
---

<RootLayout title="Projects — Chronopax" description="What Joe Burley is building." width="md">
  <section class="page-header">
    <span class="eyebrow">What I'm building</span>
    <h1>Projects</h1>
  </section>

  <div class="projects-grid">
    {projects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
  </div>

  <div class="patreon-line">
    <a href="https://patreon.com/Chronopax" target="_blank" rel="noopener noreferrer" class="patreon-link">Support this work on Patreon →</a>
  </div>
</RootLayout>

<style lang="scss">
  .page-header {
    margin: 3rem 0 2rem;
  }

  .eyebrow {
    display: block;
    font-size: 11px;
    color: var(--color-accent-teal);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: bold;
    color: var(--color-text-primary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;

    @media (max-width: 700px) {
      grid-template-columns: 1fr;
    }
  }

  .patreon-line {
    margin-bottom: 3rem;
  }

  .patreon-link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;

    &:hover {
      color: var(--color-accent-orange);
      text-decoration: underline;
    }
  }
</style>
