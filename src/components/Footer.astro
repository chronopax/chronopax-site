---
import AccentBar from './AccentBar.astro';
import "@/styles/components.scss";

const year = new Date().getFullYear();
---

<footer id="footer-container">
  <div class="footer-inner">
    <span class="copyright">Chronopax &copy; {year} Joe Burley</span>
    <div class="footer-links">
      <a href="https://linkedin.com/in/joeburley" target="_blank" rel="noopener" aria-label="LinkedIn" class="footer-icon-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>
      <a href="https://credly.com/users/joeburley" target="_blank" rel="noopener" aria-label="Credly" class="footer-icon-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 4a8 8 0 1 1 0 16A8 8 0 0 1 12 4zm0 2a6 6 0 1 0 0 12A6 6 0 0 0 12 6zm0 2l1.5 3 3.5.5-2.5 2.5.5 3.5L12 16l-3 1.5.5-3.5L7 11.5l3.5-.5L12 8z"/>
        </svg>
      </a>
    </div>
  </div>
  <AccentBar />
</footer>

<style lang="scss">
  #footer-container {
    display: flex;
    flex-direction: column;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .copyright {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .footer-icon-link {
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    transition: color 0.2s;

    &:hover {
      color: var(--color-accent-orange);
    }
  }
</style>
